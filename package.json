{
  "name": "biblez",
  "private": true,
  "version": "0.1.0",
  "description": "BibleZ \u2013 Bibelverse auswendig lernen (Web, iOS, Android)",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @biblez/client dev",
    "build": "pnpm bibles && pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify:anki": "pnpm --filter @biblez/core export:sample && (test -x .venv/bin/python && .venv/bin/python || python3) tools/anki_verify.py packages/core/.out/sample.apkg",
    "bibles": "pnpm --filter @biblez/core bibles"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zefanja/biblez-app"
  }
}
