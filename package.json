{
  "name": "biblez",
  "private": true,
  "version": "0.1.0",
  "description": "BibleZ \u2013 Bibelverse auswendig lernen (Web, iOS, Android)",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @biblez/client dev",
    "build": "pnpm bibles && pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify:anki": "sh tools/verify-anki.sh",
    "bibles": "pnpm --filter @biblez/core bibles",
    "e2e": "pnpm --filter @biblez/client build && pnpm --filter @biblez/client e2e",
    "check": "pnpm -r typecheck && pnpm --filter @biblez/core test && pnpm e2e",
    "android:apk": "sh tools/build-apk.sh",
    "icons": "node tools/generate-icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zefanja/biblez-app"
  }
}
